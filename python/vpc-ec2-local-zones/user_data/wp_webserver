#cloud-config
packages:
 - docker
write_files:
- content: |
    version: '3.1'
    services:
      wordpress:
        image: wordpress
        restart: always
        ports:
          - 8080:80
        environment:
          WORDPRESS_DB_HOST: dbhost
          WORDPRESS_DB_USER: exampleuser
          WORDPRESS_DB_PASSWORD: examplepass
          WORDPRESS_DB_NAME: exampledb
        volumes:
          - wordpress:/var/www/html
    volumes:
      wordpress:
  path: /home/ec2-user/stack.yml
runcmd:
 - [ dnf, update, -y, aws-cfn-bootstrap ]
 - [ service, docker, start ]
 - [ docker, swarm, init ]
 - [ docker, stack, deploy, -c, '/home/ec2-user/stack.yml', wordpress ]